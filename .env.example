# Copy to .env and fill in the blanks. .env is git-ignored and must never be committed.
# Every variable here is documented in docs/ARCHITECTURE.md section 9.

# --- Database (defaults match docker-compose.yml) ---
# Percent-encode every reserved character in the password: @ is %40, / is %2F, # is %23, : is %3A, ? is %3F.
# Left as they are, the URL is split in the wrong place and the connection goes to the wrong host.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/talentlens
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/talentlens_test
# Only for manual production operations (a dump copy, a one-off migration). No application reads it.
DATABASE_URL_PROD=

# --- API ---
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Embeddings ---
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- LLM (the key is secret: leave it empty here, set it in .env) ---
GEMINI_API_KEY=
# The model id is not a secret. Current: gemini-3.8-flash (gemini-2.5-flash was retired for new keys, ADR-019).
# There is deliberately no default in code: a stale default fails at the worst moment.
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_MS=15000

# --- Ingestion (secret: leave empty here, set it in .env) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=in,gb,us

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
