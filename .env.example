# Copy to .env and fill in the blanks. .env is git-ignored and must never be committed.
# Every variable here is documented in docs/ARCHITECTURE.md section 9.

# --- Database (defaults match docker-compose.yml) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/talentlens
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/talentlens_test

# --- API ---
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Embeddings ---
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- LLM (secret: leave empty here, set it in .env) ---
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_TIMEOUT_MS=15000

# --- Ingestion (secret: leave empty here, set it in .env) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=in,gb,us

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
